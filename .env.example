# K's Experience — environment variables. Copy to .env.local (local) or set in Vercel (preview/production).
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.

# Data source: "local" (default — bundled JSON) or "supabase" (needs the two public values below).
# If Supabase is unreachable the app falls back to the bundled data.
NEXT_PUBLIC_DATA_MODE=local

# Supabase public values (Project Settings → API). The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER set the service-role key in Vercel or any NEXT_PUBLIC_* variable. It is not used by the app.
# Keep it only on a trusted machine for one-off maintenance (e.g. `supabase db dump`).
# SUPABASE_SERVICE_ROLE_KEY=

# Street basemap for the HCMC "Nearby" map. Default: OpenFreeMap Positron (free, no key). "none" = offline boundary map.
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Experience-module feature flags. A module only becomes selectable when it is implemented AND its flag is "1";
# none besides Food is implemented yet, so these have no effect today (see docs/EXPERIENCE_ENGINE.md).
# NEXT_PUBLIC_FEATURE_COFFEE=
# NEXT_PUBLIC_FEATURE_BARS=
# NEXT_PUBLIC_FEATURE_SPA=
# NEXT_PUBLIC_FEATURE_SPORT=

# Build a fully static, offline preview into out/ (used by `npm run build:preview`).
# STATIC_EXPORT=1
