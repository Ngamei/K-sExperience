# K's Experience — environment variables. Copy to .env.local. Never commit real values.

# Data source: "local" (default — JSON files in data/) or "supabase" (not yet wired; see docs/IMPLEMENTATION_PLAN.md)
NEXT_PUBLIC_DATA_MODE=local

# Supabase (public, browser-safe values only). Leave empty for local mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit. Only needed for admin import jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Street basemap style for the HCMC "Nearby" map. Default: OpenFreeMap Positron (free, no key).
# Set to "none" to always use the offline boundary-only map.
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Build a fully static, offline preview into out/ (used by `npm run build:preview`).
# STATIC_EXPORT=1
