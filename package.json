{
  "name": "ks-experience",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build",
    "build:e2e": "NEXT_PUBLIC_DEV_DATA=1 next build",
    "build:preview": "node scripts/copy-vendor.mjs && STATIC_EXPORT=1 next build && node scripts/package-preview.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "data:geo": "tsx scripts/build-geo.ts",
    "data:seed": "node scripts/seed-rows.mjs && tsx scripts/import-catalogue.ts data/source/seed-catalogue.json",
    "data:import": "tsx scripts/import-catalogue.ts",
    "data:import-module": "tsx scripts/import-experience.ts",
    "data:research": "tsx scripts/build-experience-research.ts",
    "data:experiences": "tsx scripts/experience-report.ts",
    "data:validate": "vitest run tests/integration",
    "qa": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:e2e && npm run test:e2e && npm run build:auth-test && npm run test:e2e-auth && npm run build:modules-test && npm run test:e2e-modules",
    "data:restaurants": "tsx scripts/import-restaurants.ts",
    "data:coverage": "tsx scripts/venue-coverage.ts",
    "data:report": "tsx scripts/data-report.ts",
    "db:seed-sql": "tsx scripts/build-supabase-seed.ts",
    "test:db": "bash scripts/test-db.sh",
    "db:export": "tsx scripts/export-supabase.ts",
    "build:auth-test": "node scripts/copy-vendor.mjs && STATIC_EXPORT=1 BUILD_DIST_DIR=out-auth NEXT_PUBLIC_DATA_MODE=supabase NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key NEXT_PUBLIC_FEATURE_COFFEE=1 NEXT_PUBLIC_BASEMAP_STYLE_URL=none next build",
    "test:e2e-auth": "playwright test -c playwright.auth.config.ts",
    "build:modules-test": "node scripts/copy-vendor.mjs && STATIC_EXPORT=1 BUILD_DIST_DIR=out-modules NEXT_PUBLIC_FEATURE_COFFEE=1 NEXT_PUBLIC_BASEMAP_STYLE_URL=none next build",
    "test:e2e-modules": "playwright test -c playwright.modules.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.82.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "supercluster": "^9.1.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "mapshaper": "^0.8.13",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  }
}
