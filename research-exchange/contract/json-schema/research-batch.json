{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "externalBatchId": {
      "type": "string"
    },
    "batchId": {
      "type": "string",
      "pattern": "^(CC|GPT|CX|PO)-[A-Z]+-\\d{3}$"
    },
    "experience": {
      "type": "string",
      "enum": [
        "food",
        "coffee",
        "bars",
        "spa",
        "sport"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "venues",
        "catalogue"
      ]
    },
    "agent": {
      "type": "string",
      "enum": [
        "claude-code",
        "chatgpt",
        "codex",
        "product-owner"
      ]
    },
    "researchedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "method": {
      "type": "string",
      "minLength": 10
    },
    "venues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "address": {
            "type": "string",
            "minLength": 4
          },
          "district": {
            "type": "string"
          },
          "venueType": {
            "type": "string"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https:\\/\\/[^\\s]+\\.[^\\s]+"
            }
          },
          "dishes": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "dishId": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 10
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https:\\/\\/[^\\s]+\\.[^\\s]+"
                    },
                    "priceVnd": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "integer",
                          "minimum": 1000,
                          "maximum": 10000000
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 1000,
                          "maximum": 10000000
                        }
                      },
                      "required": [
                        "min",
                        "max"
                      ]
                    },
                    "photo": {}
                  },
                  "required": [
                    "dishId"
                  ]
                }
              ]
            }
          },
          "offerings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 10
                },
                "url": {
                  "type": "string",
                  "pattern": "^https:\\/\\/[^\\s]+\\.[^\\s]+"
                },
                "price": {
                  "type": "object",
                  "properties": {
                    "minVnd": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 9007199254740991
                    },
                    "maxVnd": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 50000000
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "minVnd",
                    "maxVnd",
                    "unit"
                  ]
                },
                "photo": {}
              },
              "required": [
                "item",
                "evidence",
                "url"
              ]
            }
          },
          "lon": {
            "type": [
              "number",
              "null"
            ]
          },
          "lat": {
            "type": [
              "number",
              "null"
            ]
          },
          "openingHours": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "mon": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "tue": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "wed": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "thu": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "fri": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "sat": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "sun": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        },
                        {
                          "type": "string",
                          "pattern": "^\\d{2}:\\d{2}$"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                },
                "required": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "priceRange": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "$",
                  "$$",
                  "$$$",
                  "$$$$"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "attributes": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "note": {
            "type": "string"
          },
          "excluded": {
            "type": "string"
          },
          "confirmDistinct": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "address",
          "sources"
        ]
      }
    },
    "dishes": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "batchId",
    "experience",
    "kind",
    "agent",
    "researchedOn",
    "method"
  ]
}
