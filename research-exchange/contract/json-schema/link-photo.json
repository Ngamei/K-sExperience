{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "kind": {
      "type": "string",
      "enum": [
        "venue-specific",
        "menu-photo",
        "delivery-listing",
        "generic-dish"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "lastCheckedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    }
  },
  "required": [
    "url",
    "kind",
    "sourceUrl",
    "attribution",
    "license",
    "lastCheckedAt"
  ]
}
