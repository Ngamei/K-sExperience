    "rejected": {
      "khau-nhuc": "photo is Hong Kong Hakka kau yuk",
      "nem-chua-thanh-hoa": "photo taken in Laos",
      "bun-nuoc-leo-soc-trang": "photo is a bún bò Huế variation",
      "hu-tieu-my-tho": "photo content unclear",
      "banh-flan": "generic baked custard",
      "thang-co": "uploader unsure of dish",
      "banh-canh-ghe-vung-tau": "Commons photos show bánh canh cua (crab), not ghẹ Vũng Tàu",
      "bun-cha-ca-da-nang": "Commons bún chả cá photos name no city",
      "bun-cha-ca-quy-nhon": "Commons bún chả cá photos name no city",
      "com-lam-ga-nuong-tay-nguyen": "Commons photo is cơm lam with pork skewers",
      "banh-gai-ninh-giang": "Commons bánh gai photos are Nam Định / Tứ Trụ",
      "banh-mi-hoi-an": "Commons photo shows the Bánh Mì Phượng shop, not the sandwich"
    },
    "added20261128": "2026-11-28: 4 photos (bánh mì que Hải Phòng, bánh tráng nướng Đà Lạt, hủ tiếu Mỹ Tho, phở gà Hà Nội) chosen from Commons dish categories because their title/description names the exact dish and place; licence/author from the Commons API. Visual check pending (image hosts blocked/rate-limited from the cloud sandbox) — PO to confirm on the live dish pages."
